{
  "name": "noted",
  "productName": "Noted",
  "author": {
    "name": "David Winter",
    "email": "i@djw.me",
    "url": "https://davidwinter.dev"
  },
  "version": "0.6.0",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidwinter/noted.git"
  },
  "scripts": {
    "dev": "electron-webpack dev",
    "compile": "electron-webpack",
    "dist": "yarn compile && electron-builder",
    "dist:dir": "yarn dist --dir -c.compression=store -c.mac.identity=null",
    "release": "yarn compile && electron-builder build --publish always",
    "test": "jest",
    "lint": "eslint src",
    "storybook": "start-storybook"
  },
  "jest": {
    "setupFiles": [
      "./tests/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(scss)$": "identity-obj-proxy"
    }
  },
  "electronWebpack": {
    "renderer": {
      "webpackConfig": "webpack.renderer.config.js"
    }
  },
  "build": {
    "appId": "dev.davidwinter.noted",
    "mac": {
      "target": "zip"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "electron-store": "^5.1.1",
    "electron-updater": "^4.3.1",
    "fuzzy": "^0.1.3",
    "mousetrap": "^1.6.5",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "source-map-support": "^0.5.16",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.9.4",
    "@storybook/react": "^5.3.18",
    "babel-jest": "^25.5.1",
    "electron": "8.2.0",
    "electron-builder": "^22.4.1",
    "electron-webpack": "^2.8.2",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.2",
    "eslint": "^6.8.0",
    "eslint-config-airbnb": "^18.1.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react": "^7.19.0",
    "eslint-plugin-react-hooks": "^2.5.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^25.5.4",
    "node-sass": "^4.14.0",
    "sass-loader": "^8.0.2",
    "url-loader": "^4.1.0",
    "webpack": "~4.42.1"
  }
}
