{
  "name": "noted",
  "productName": "Noted",
  "description": "Your notes, powered by the keyboard",
  "homepage": "https://notedapp.org",
  "author": {
    "name": "David Winter",
    "email": "i@djw.me",
    "url": "https://davidwinter.dev"
  },
  "version": "0.6.9",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidwinter/noted.git"
  },
  "scripts": {
    "dev": "electron-webpack dev",
    "storybook": "start-storybook",
    "lint": "xo",
    "test": "ava",
    "build": "electron-webpack && electron-builder --publish never",
    "release": "standard-version",
    "cm": "git-cz"
  },
  "xo": {
    "extends": "xo-react",
    "envs": [
      "node",
      "browser"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "electronWebpack": {
    "renderer": {
      "webpackConfig": "webpack.renderer.config.js"
    }
  },
  "build": {
    "appId": "dev.davidwinter.noted",
    "mac": {
      "target": "default"
    },
    "linux": {
      "target": "snap",
      "category": "Utility"
    }
  },
  "dependencies": {
    "electron-store": "^5.1.1",
    "fuzzy": "^0.1.3",
    "mousetrap": "^1.6.5",
    "prop-types": "^15.7.2",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "source-map-support": "^0.5.16",
    "update-electron-app": "^1.5.0",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.9.4",
    "@commitlint/cli": "^8.3.5",
    "@commitlint/config-conventional": "^8.3.4",
    "@storybook/react": "^5.3.18",
    "ava": "^3.8.2",
    "commitizen": "^4.1.2",
    "cz-conventional-changelog": "^3.2.0",
    "electron": "8.2.0",
    "electron-builder": "^22.4.1",
    "electron-webpack": "^2.8.2",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.2",
    "eslint-config-xo-react": "^0.23.0",
    "eslint-plugin-react": "^7.20.0",
    "eslint-plugin-react-hooks": "^4.0.2",
    "husky": "^4.2.5",
    "identity-obj-proxy": "^3.0.0",
    "node-sass": "^4.14.0",
    "sass-loader": "^8.0.2",
    "standard-version": "^8.0.0",
    "url-loader": "^4.1.0",
    "webpack": "~4.42.1",
    "xo": "^0.30.0"
  }
}
