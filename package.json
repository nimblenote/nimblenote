{
	"name": "nimblenote",
	"productName": "nimblenote",
	"description": "Simple keyboard-driven note taking",
	"homepage": "https://nimblenote.app",
	"author": {
		"name": "leaves under foot ltd",
		"email": "hello@leavesunderfoot.com",
		"url": "https://leavesunderfoot.com"
	},
	"version": "1.2.1",
	"license": "UNLICENSED",
	"scripts": {
		"dev": "electron-webpack dev",
		"lint": "xo",
		"test": "ava",
		"build": "electron-webpack && electron-builder --publish never",
		"release": "standard-version",
		"cm": "git-cz"
	},
	"xo": {
		"extends": "xo-react",
		"envs": [
			"node",
			"browser"
		]
	},
	"ava": {
		"require": [
			"./setup-tests.js"
		],
		"babel": {
			"extensions": [
				"js",
				"jsx"
			],
			"testOptions": {
				"presets": [
					"@babel/preset-react"
				]
			}
		}
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"husky": {
		"hooks": {
			"pre-commit": "yarn lint && yarn test",
			"commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
		}
	},
	"electronWebpack": {
		"whiteListedModules": [
			"codemirror",
			"react-codemirror2"
		],
		"renderer": {
			"webpackConfig": "webpack.renderer.config.js"
		}
	},
	"build": {
		"appId": "com.leavesunderfoot.nimblenote",
		"mac": {
			"provisioningProfile": "nimblenote_distribution_profile.provisionprofile",
			"target": [
				"mas",
				"zip"
			]
		},
		"linux": {
			"target": "snap",
			"category": "Utility"
		}
	},
	"dependencies": {
		"codemirror": "5.54.0",
		"electron-store": "5.1.1",
		"fuzzy": "0.1.3",
		"mousetrap": "1.6.5",
		"prop-types": "15.7.2",
		"react": "16.13.1",
		"react-codemirror2": "7.2.0",
		"react-dom": "16.13.1",
		"source-map-support": "0.5.16",
		"update-electron-app": "1.5.0",
		"winston": "3.2.1",
		"yargs": "15.3.1"
	},
	"devDependencies": {
		"@ava/babel": "1.0.1",
		"@babel/preset-react": "7.10.1",
		"@babel/register": "7.10.1",
		"@commitlint/cli": "8.3.5",
		"@commitlint/config-conventional": "8.3.4",
		"ava": "3.8.2",
		"browser-env": "3.3.0",
		"commitizen": "4.1.2",
		"cz-conventional-changelog": "3.2.0",
		"electron": "9.0.2",
		"electron-builder": "22.7.0",
		"electron-webpack": "2.8.2",
		"enzyme": "3.11.0",
		"enzyme-adapter-react-16": "1.15.2",
		"eslint-config-xo-react": "0.23.0",
		"eslint-plugin-react": "7.20.0",
		"eslint-plugin-react-hooks": "4.0.4",
		"husky": "4.2.5",
		"identity-obj-proxy": "3.0.0",
		"node-sass": "4.14.1",
		"pirates": "4.0.1",
		"sass-loader": "8.0.2",
		"standard-version": "8.0.0",
		"url-loader": "4.1.0",
		"webpack": "4.43.0",
		"xo": "0.30.0"
	}
}
